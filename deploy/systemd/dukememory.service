[Unit]
Description=dukememory local-first HTTP service
Documentation=https://github.com/danilkryachko/dukememory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dukememory
Group=dukememory
WorkingDirectory=/var/lib/dukememory
EnvironmentFile=-/etc/dukememory/dukememory.env
Environment=HF_HOME=/var/lib/dukememory/models/huggingface
ExecStart=/usr/local/bin/dukememory --db /var/lib/dukememory/.agent/memory.db serve-http --host 127.0.0.1 --port 8765 --auth-token-file /etc/dukememory/http-token
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/dukememory

[Install]
WantedBy=multi-user.target
